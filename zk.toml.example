# Copy to zk.toml and edit — this file is never read.
#
# zk.toml is searched from the current directory upward, stopping at the repo
# root — the nearest ancestor holding .git. A zk.toml above that root is never
# found. ZK_VAULT outranks this file entirely; set it and nothing here runs.
#
# zk.toml is gitignored. This example is committed.

[zk]

# Absolute path to the vault root. Relative paths are never resolved.
# All three string forms parse to the same directory:
#   vault = "C:/Users/you/OneDrive/vault"
#   vault = "C:\\Users\\you\\OneDrive\\vault"
#   vault = 'C:\Users\you\OneDrive\vault'
# A single unescaped backslash is invalid TOML — \U opens a Unicode escape.
vault = "C:/Users/you/OneDrive/vault"

# Top-level directory names whose "not in the vault schema" warning is silenced.
# Exact names only: no globs, no paths, no trailing slash.
# It silences warnings and grants nothing — an ignored directory is still never
# indexed, linted, or recalled. Listing private or archive is a hard error.
# ignore = [".obsidian", "attachments"]
